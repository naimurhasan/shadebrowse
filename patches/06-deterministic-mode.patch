+constexpr int64_t kShadeEpochSeconds = 1735689600;
+
+base::Time ShadeFixedNow() {
+  static const base::TimeTicks start = base::TimeTicks::Now();
+  return base::Time::FromSecondsSinceUnixEpoch(kShadeEpochSeconds) +
+         (base::TimeTicks::Now() - start);
+}
+
+void ApplyShadeDeterministicMode() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch("shade-deterministic")) {
+    return;
+  }
+  uint64_t seed = 0;
+  base::StringToUint64(command_line.GetSwitchValueASCII("shade-seed"), &seed);
+  const std::string flag =
+      "--random-seed=" + base::NumberToString(static_cast<int>(seed % 2147483647) + 1);
+  v8::V8::SetFlagsFromString(flag.data(), flag.size());
+  static base::NoDestructor<base::subtle::ScopedTimeClockOverrides> overrides(
+      &ShadeFixedNow, nullptr, nullptr);
+}
