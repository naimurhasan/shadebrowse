+#include <optional>
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+class SkPixmap;
+
+namespace blink::shade {
+
+PLATFORM_EXPORT std::optional<uint64_t> Seed();
+PLATFORM_EXPORT uint64_t Mix(uint64_t seed, uint64_t value);
+PLATFORM_EXPORT void PerturbPixels(const SkPixmap& pixmap, uint64_t seed);
+PLATFORM_EXPORT void PerturbSamples(float* samples,
+                                    size_t count,
+                                    uint64_t seed);
+PLATFORM_EXPORT unsigned PickConcurrency(unsigned real, uint64_t seed);
+PLATFORM_EXPORT float PickDeviceMemory(float real, uint64_t seed);
+
+}
